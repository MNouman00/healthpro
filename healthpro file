    <script>
        // Mobile menu toggle
        document.querySelector('.mobile-toggle').addEventListener('click', function() {
            document.querySelector('.nav-menu').classList.toggle('active');
        });

        // Close mobile menu when clicking on a link
        document.querySelectorAll('.nav-menu a').forEach(link => {
            link.addEventListener('click', function() {
                document.querySelector('.nav-menu').classList.remove('active');
            });
        });

        // Initialize map
        function initMap() {
            // Coordinates for the clinic (example coordinates for a central location)
            const clinicLocation = [40.7128, -74.0060]; // New York City coordinates
            
            // Create map
            const map = L.map('map').setView(clinicLocation, 15);
            
            // Add tile layer (OpenStreetMap)
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);
            
            // Add marker for clinic location
            const clinicMarker = L.marker(clinicLocation).addTo(map);
            clinicMarker.bindPopup("<b>ProHealth Clinic</b><br>123 Wellness Street<br>Health City, HC 12345").openPopup();
            
            // Add circle to highlight the area
            L.circle(clinicLocation, {
                color: '#2a9d8f',
                fillColor: '#2a9d8f',
                fillOpacity: 0.1,
                radius: 300
            }).addTo(map);
        }
        
        // Initialize the map when the page loads
        document.addEventListener('DOMContentLoaded', initMap);
        
        // Contact form submission
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Get form values
            const name = document.getElementById('name').value;
            const email = document.getElementById('email').value;
            const service = document.getElementById('service').value;
            
            // In a real application, you would send this data to a server
            // For this example, we'll just show an alert
            alert(`Thank you, ${name}! Your message has been sent. We will contact you at ${email} regarding ${service || 'your inquiry'} soon.`);
            
            // Reset the form
            this.reset();
        });
    </script>
